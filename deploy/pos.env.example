# Production settings, for /etc/pos.env
#
#   sudo cp deploy/pos.env.example /etc/pos.env
#   sudo chown pos:pos /etc/pos.env
#   sudo chmod 600 /etc/pos.env          # it holds two secrets
#   sudo nano /etc/pos.env               # fill in the blanks below
#
# The server refuses to start in production with either secret missing or too
# short. That is deliberate: both failures are silent otherwise, and the second
# one is only noticed months later when a customer asks for their iCloud
# password back.

NODE_ENV=production
PORT=4000

# Where the shop's books live.
#
# Outside the checkout on purpose: a deploy pulls, rebuilds and can be reset,
# and none of that must be able to touch this file.
#   sudo mkdir -p /var/lib/pos && sudo chown pos:pos /var/lib/pos
DB_PATH=/var/lib/pos/data.sqlite

# Signs the login tokens. Rotating it logs everybody out, which is what you
# want after a laptop goes missing.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Encrypts the iCloud and email passwords the shop keeps on a customer's behalf.
#
# NOT the same as JWT_SECRET, and not to be rotated casually: change this and
# every stored password becomes unreadable, permanently. Back it up somewhere
# that is not this server — a database restored without it is a database with
# the passwords gone.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCOUNT_SECRET=

# Sales tax, as a fraction. 0 for no tax.
TAX_RATE=0.08

# Where the nightly copies go, and how many to keep.
BACKUP_DIR=/var/backups/pos
BACKUP_KEEP=30

# Somewhere that is not this machine. A backup on the same disk as the database
# is a second copy of the same disk failure.
#   BACKUP_SYNC=user@othermachine:/backups/pos     (over ssh, via rsync)
#   BACKUP_SYNC=gdrive:pos-backups                 (via rclone)
# BACKUP_SYNC=
