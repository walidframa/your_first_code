dist/

# npm's cache. On a server the app's user often has the checkout as its home
# directory, which puts this inside the repository — where it looks to `git
# status` like somebody has been working here, and stops the next deploy.
.npm/
.env
*.sqlite
*.sqlite-wal
*.sqlite-shm
.DS_Store

# Built manuals: regenerated by `npm run manual`, not worth versioning.
docs/manual/out/
docs/manual/shots/

# Local e2e run logs.
e2e*.log
