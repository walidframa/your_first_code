PORT=4000
TAX_RATE=0.08

# Required in production — the server refuses to start without it when
# NODE_ENV=production, and requires at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Encrypts the iCloud / Gmail passwords the shop keeps on a customer's behalf.
# Deliberately separate from JWT_SECRET: that one gets rotated when a session
# leaks, and rotating this one makes every stored password unreadable.
# Without it, development uses a throwaway key that dies on restart, and
# production refuses to start.
ACCOUNT_SECRET=
